{
  "name": "office-crawler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test",
    "e2e": "node build.mjs && node e2e/run-all.mjs",
    "bench": "node build.mjs && node bench/bench.mjs",
    "bot": "node bot/run-headless.mjs",
    "bot:browser": "node build.mjs && node bot/run-browser.mjs",
    "bot:report": "node build.mjs && node bot/write-report.mjs",
    "shots": "node build.mjs && node e2e/shots.mjs",
    "shots:ui": "node build.mjs && node e2e/ui-shots.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "playwright": "1.56.1"
  }
}
